{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thiep-hen-ho",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thiep-hen-ho",
      "database_id": "a75e79f7-6f48-410d-9843-81ae4be0dcc2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
