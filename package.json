{
  "name": "date-with-you",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && npm run db:migrate:local && concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node scripts/prepare-local.mjs && wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "npm run db:migrate:local && npm run dev:server",
    "dev:node": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --mode node\"",
    "start:node": "tsx server/index.ts",
    "cf:login": "wrangler login",
    "cf:setup": "node scripts/cloudflare-setup.mjs",
    "deploy": "npm run build && node scripts/cloudflare-deploy.mjs",
    "deploy:check": "wrangler deploy --dry-run --outdir test-results/worker-bundle",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "miniflare": "^5.20261102.0-beta",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "wrangler": "^4.156.2"
  }
}
